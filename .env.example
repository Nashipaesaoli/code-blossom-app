# Copy this file to ".env" and fill in your own values.
# Never commit ".env" to GitHub. It is already listed in .gitignore.

# Where your database lives. Paste the connection string from Neon, Supabase, or your local Postgres.
# Example (local):  postgres://postgres:password@localhost:5432/blossom
# Example (Neon):   postgres://user:pass@ep-something.neon.tech/neondb?sslmode=require
DATABASE_URL=

# The password you type on the sign-in page. Pick something long that you don't use anywhere else.
APP_PASSWORD=

# A long random string used to sign your login cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to "production" on your live site. This makes the login cookie HTTPS-only.
NODE_ENV=development

# Only needed if your database requires SSL but its connection string has no "sslmode=require" in it.
# DATABASE_SSL=true

# Optional. Most hosts set this for you.
# PORT=3000
